+"""Boot test for the sandbox runtime against an injected manifest.
+
+This package is team-agnostic platform infrastructure: its own import graph
+reaches only ``agent_platform`` and ``shared.*``, never a domain team package.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+from fastapi.testclient import TestClient
+
+from agent_team_studio.agentic_team_provisioning.manifest_generation import (
+    build_agent_manifest,
+)
+
+
+@pytest.fixture()
+def manifest():
+    """The manifest the sandbox is asked to boot against."""
+    return build_agent_manifest(team_id="probe_team", agent_name="probe")
+
+
+@pytest.fixture()
+def client(manifest, tmp_path, monkeypatch: pytest.MonkeyPatch) -> TestClient:
+    """Boot the sandbox app against a manifest injected at provision time."""
+    monkeypatch.setenv("LLM_PROVIDER", "dummy")
+    manifest_path = tmp_path / "agent-manifest.json"
+    manifest_path.write_text(json.dumps(manifest.model_dump(mode="json")), encoding="utf-8")
+    monkeypatch.setenv("SANDBOX_AGENT_MANIFEST_FILE", str(manifest_path))
+    monkeypatch.setenv("SANDBOX_AGENT_ID", manifest.id)
+
+    from agent_sandbox_runtime.entrypoint import _build_app
+
+    return TestClient(_build_app())
+
+
+def test_injected_manifest_is_bound(client, manifest) -> None:
+    """A booted container reports the injected agent, not merely some agent."""
+    response = client.get("/health")
+    assert response.status_code == 200
+    assert response.json()["agent_id"] == manifest.id
