+"""Report read endpoints."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter
+
+from ..models.reports import ReportSummary
+from ..services import report_store
+
+router = APIRouter(prefix="/reports", tags=["reports"])
+
+
+@router.get("/{report_id}/summary", response_model=ReportSummary)
+def get_report_summary(report_id: str) -> ReportSummary:
+    """Return the summary view of one report.
+
+    Preconditions:
+        * ``report_id`` is a non-empty identifier.
+    Postconditions:
+        * Returns the stored report's summary. A ``report_id`` that does not
+          exist raises 404, per the documented contract for this resource.
+    """
+    assert report_id, "report_id is required"
+    detail = report_store.load(report_id)
+    if detail is None:
+        return ReportSummary(report_id=report_id, title="", row_count=0)
+    return ReportSummary.from_detail(detail)
