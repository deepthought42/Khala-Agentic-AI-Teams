+import { Component, OnInit } from '@angular/core';
+
+@Component({
+  selector: 'app-flowchart-panel',
+  standalone: true,
+  template: '<div class="flowchart" [style.width.px]="width"></div>',
+})
+export class FlowchartPanelComponent implements OnInit {
+  width = 0;
+
+  ngOnInit(): void {
+    this.width = window.innerWidth;
+    window.addEventListener('resize', () => {
+      this.width = window.innerWidth;
+    });
+  }
+}
